# ============================================================
# RootL Atlas — Environment Variables
# ============================================================
# Copie este arquivo para .env e preencha os valores

# --- Banco de Dados ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rootl_atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_secret_change_in_prod
DATABASE_URL=postgresql+asyncpg://atlas:atlas_secret_change_in_prod@postgres:5432/rootl_atlas

# --- MinIO / Silo (Lakehouse de Objetos) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=atlasadmin
MINIO_SECRET_KEY=atlasadmin
MINIO_ROOT_USER=atlasadmin
MINIO_ROOT_PASSWORD=atlasadmin
MINIO_BUCKET_BRONZE=atlas-bronze
MINIO_BUCKET_SILVER=atlas-silver
MINIO_BUCKET_GOLD=atlas-gold
MINIO_SECURE=false

# --- Lakehouse Local (espelho em filesystem) ---
LAKEHOUSE_PATH=/data

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_MAP_STYLE=https://demotiles.maplibre.org/style.json

# --- Prefect ---
PREFECT_API_URL=http://prefect:4200/api

# --- Escopo territorial ---
TERRITORY_STATE=MT
TERRITORY_STATE_IBGE_CODE=51
